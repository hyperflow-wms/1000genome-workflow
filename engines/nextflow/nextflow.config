// Konfiguracja portu 1000genome na Nextflow.
// Wszystkie procesy uzywaja ORYGINALNEGO obrazu worker z HyperFlow — reuse nauki 1:1.

docker {
    enabled = true
    runOptions = '--platform linux/amd64'   // obrazy sa amd64; na Apple Silicon idzie przez emulacje
}

process {
    // Obraz pochodny z bash (Nextflow go wymaga) — patrz worker-nf.Dockerfile.
    // :1.3 = streaming individuals.py (port fixu z HyperFlow ee112c1): ~1.8x szybciej,
    // pamiec ~19 MB/job zamiast ~4.7 GB, wyniki naukowo identyczne (A/B na brca1/GBR).
    // Poprzedni baseline: :latest (stary individuals.py z obrazu worker 1.1).
    container = '1000genome-worker-nf:1.4'
}

// Limity zasobow. Gdy composer poda --task_mem, jest to est_peak_mb z
// recommend_parallelism — ten sam szacunek, ktory wyznaczyl ind_jobs
// i ind_max_forks. Bez niego zostaje awaryjne domyslne dla recznego runu.
// Domknięcie, nie wyrażenie: wewnatrz `process {}` gole `params.x` rozwiazuje
// sie jako `process.params.x`. Closure jest wyliczane przy zgloszeniu zadania,
// gdy params sa juz scalone z linii polecen.
process {
    cpus   = 2
    memory = 4.GB

    // task_mem to est_peak_mb z recommend_parallelism, ktory modeluje WYLACZNIE
    // etap individuals (12 MB + 1.2 MB na 1e6 wariant*osobnik pracy). To nie
    // jest budzet dla calego pipeline'u: mutation_overlap i frequency trzymaja
    // duzo wiecej i przy tym limicie sa zabijane przez OOM (exit 137).
    // Ograniczamy go do etapu, ktorego dotyczy szacunek.
    withName: INDIVIDUALS {
        memory = { params.task_mem ?: 4.GB }
    }
}

// Raporty wykonania (przydatne do magisterki — benchmark vs HyperFlow)
timeline.enabled = true
report.enabled   = true
trace.enabled    = true
dag.enabled      = true
timeline.overwrite = true
report.overwrite   = true
trace.overwrite    = true
dag.overwrite      = true
